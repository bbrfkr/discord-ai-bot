# --- 接続先 opencode サーバー（必須）---
# 別デプロイの opencode-server の URL。docker compose / ローカル実行いずれも必須。
# 例: http://opencode-server-host:4096 / http://127.0.0.1:4096
OPENCODE_BASE_URL=http://127.0.0.1:4096

# 使用モデル（任意）。未指定なら opencode サーバの既定モデルを使用する。
# 例: bbrfkr-llm / bbrfkr-llm-medium
# OPENCODE_PROVIDER_ID=bbrfkr-llm
# OPENCODE_MODEL_ID=bbrfkr-llm-medium

# opencode へのリクエストタイムアウト（ms、任意）。未指定なら 3600000（60分）。
# 長時間かかる AI ターンが bot 側 undici の既定5分で切られるのを防ぐための値。
# 0 にすると無制限（ハング時に永久待機・リソース滞留の懸念あり）。
# OPENCODE_REQUEST_TIMEOUT_MS=3600000

# 添付ファイルをモデルに file part として渡す mime prefix（任意・カンマ区切り）。
# 既定は image/ のみ。これに一致しない添付（model/stl 等）はモデルに渡さず、
# 署名付き URL を本文に添えて agent に渡す（agent が curl 等で取得して処理）。
# 例: image/,application/pdf
# OPENCODE_INLINE_MIME_PREFIXES=image/

# --- Discord bot 用（必須） ---
# Bot のトークン（Developer Portal > Bot > Reset Token）
DISCORD_TOKEN=
# 監視対象チャンネルの ID（Discordで開発者モードON → チャンネル右クリック → IDをコピー）
DISCORD_TARGET_CHANNEL_ID=

# --- デバッグ（任意） ---
# 進捗が出ないときの調査用。1 にすると、流れてきたイベント型名と tool パートの
# type/tool/status をログ出力する（実体のイベント形状が想定とズレていないか確認できる）。
# PROGRESS_DEBUG=1
